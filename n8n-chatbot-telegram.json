      "parameters": {
        "jsCode": "// دریافت متن خروجی از ایجنت\nlet outputText = $input.first().json.output || \"\";\n\n// ۱. حذف فقط کاراکترهای * و -\noutputText = outputText.replace(/[*\\-]/g, \"\");\n\n// ۲. ایمن‌سازی کاراکترهای اصلی HTML برای تلگرام\noutputText = outputText\n  .replace(/&/g, \"&amp;\")\n  .replace(/</g, \"&lt;\")\n  .replace(/>/g, \"&gt;\");\n\n// بازگرداندن متن با حفظ کامل فاصله‌ها و اینترها\nreturn {\n  json: {\n    safeOutput: outputText.trim()\n  }\n};"
